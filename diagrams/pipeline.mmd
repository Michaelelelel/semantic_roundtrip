---
title: All stages are optional. Enabled stages require their inputs.
config:
  theme: base
  fontFamily: Arial, sans-serif
  flowchart:
    curve: linear
    nodeSpacing: 12
    rankSpacing: 8
    htmlLabels: false
    padding: 6
    wrappingWidth: 600
    subGraphTitleMargin:
      top: 4
      bottom: 10
  themeVariables:
    fontFamily: Arial, sans-serif
    fontSize: 20px
    primaryColor: '#edf3f8'
    primaryTextColor: '#152c40'
    primaryBorderColor: '#526b80'
    lineColor: '#52616c'
    clusterBkg: '#ffffff'
    clusterBorder: '#c2ccd4'
    edgeLabelBackground: '#ffffff'
---
flowchart TB
    %% Editable source for both the documentation SVG and thesis PDF.
    %% The two panels reuse stored artifacts, not regenerated copies.
    subgraph routes["A. Generation and reconstruction"]
        direction LR
        source(["Title and<br/>domain"])
        pg["PG<br/>Prompt<br/>generation"]
        ig["IG<br/>Image<br/>generation"]
        id["ID<br/>Image<br/>description"]
        direct["TG<br/>Image + domain"]
        indirect["TG<br/>Description + domain"]
        prompttg["TG<br/>Prompt + domain"]
        rating["Illustratability<br/>rating"]

        source --> pg
        source --> rating
        pg -->|prompt| ig
        %% Longer links align the three TG alternatives in one right-hand column.
        pg ---->|prompt| prompttg
        ig --->|image| direct
        ig -->|image| id
        id -->|text| indirect
        %% Every TG also receives the domain, stated inside each input box.
    end

    subgraph assessment["B. Independent checks and evaluation of each predicted title"]
        direction TB
        promptcheck["Prompt check (deterministic)<br/>Prompt + source title<br/>Normalized title absent"]
        strictcheck["Strict image check<br/>Image only<br/>No meaningful readable text"]
        awarecheck["Title-aware check<br/>Image + source title<br/>No readable source title"]
        score["Title match + applicable checks<br/>Strict and title-aware are alternative image policies"]

        promptcheck --> score
        strictcheck --> score
        awarecheck --> score
    end

    routes ~~~ assessment
    classDef context fill:#ffffff,stroke:#526b80,color:#152c40;
    classDef check fill:#f5f5f5,stroke:#68737b,color:#253541;
    class source context;
    class promptcheck,strictcheck,awarecheck check;
