# Virtuelle Umgebungen
.venv/
venv/

# Python Cache
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Python build artifacts
build/
dist/
*.egg-info/

# PyCharm
.idea/

# Mac OS
.DS_Store

# Environment
.env

# Model weights stay local; only category roots and documentation are tracked.
models/*
!models/README.md
!models/download-*.sh
!models/text/
!models/image/
!models/vision/
!models/multimodal/
models/text/*
models/image/*
models/vision/*
models/multimodal/*
!models/text/.gitkeep
!models/text/download-*.sh
!models/image/.gitkeep
!models/image/download-*.sh
!models/image/checkpoints/
models/image/checkpoints/*
!models/image/checkpoints/.gitkeep
!models/vision/.gitkeep
!models/vision/download-*.sh
!models/multimodal/.gitkeep
!models/multimodal/download-*.sh
models_vlm/
*.gguf
*.safetensors
*.ckpt

# Downloaded chat templates stay local; only their download scripts are tracked.
chat_templates/*
!chat_templates/download.sh

# Runtime data stays local, but mount roots must exist before Docker starts.
runs/
/runtime/
*.sqlite
*.db

# Notebook outputs are generated locally; the source notebook is tracked.
notebooks/results/
notebooks/.ipynb_checkpoints/

# Large or licensed source snapshots used to build the title benchmark stay local.
/data/title_sources/
